# Credenciais de acesso ao ARMADA.
# Copie para .env.local e troque os valores.
ARMADA_ACCESS_USER=armada
ARMADA_ACCESS_CODE=123456

# Onde a ficha é gravada.
# Sem estas duas, ela vai para data/character.json — o que serve em
# desenvolvimento, mas não em hospedagem serverless, onde o disco é
# somente-leitura. Em produção, crie um Redis e a plataforma as injeta.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
